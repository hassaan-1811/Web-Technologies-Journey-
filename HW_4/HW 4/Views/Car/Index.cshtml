@model IEnumerable<Assignment_1.Models.Car>

@{
    ViewData["Title"] = "Available Cars";
}

<h2 class="mb-2">Available Cars</h2>
<p class="text-muted mb-4">Please select a car from the list below to proceed with your booking.</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info" role="alert">
        There are currently no cars available for booking. Please check back later.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">

        @foreach (var car in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm p-2">

                    <div class="card-body d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0">@car.Name</h5>
                            <span class="badge bg-success">Available</span>
                        </div>

                        <p class="card-text fs-5">
                            <span>@car.PricePerDay PKR</span> <span class="text-muted fs-6">/ day</span>
                        </p>

                        <form asp-controller="Car" asp-action="Book" method="post" class="mt-auto">
                            <input type="hidden" name="id" value="@car.Id" />

                            <button type="submit" class="btn btn-primary w-100">
                                Book Car
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        }
    </div>
}