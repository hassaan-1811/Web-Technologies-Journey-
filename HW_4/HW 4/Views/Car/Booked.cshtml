@model IEnumerable<Assignment_1.Models.Car>

@{
    ViewData["Title"] = "Booked Cars";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Booked Cars</h2>
    <a asp-controller="Car" asp-action="Index" class="btn btn-outline-secondary">
        Back to Cars
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info shadow-sm" role="alert">
        There are currently no booked cars.
    </div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Car Name</th>
                    <th>Price Per Day</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>@car.Id</td>
                        <td><strong>@car.Name</strong></td>
                        <td>@car.PricePerDay PKR</td>
                        <td>
                            <span class="badge bg-warning text-dark">Booked</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}